r: black;\r\n      border: none;\r\n      border-radius: 20px;\r\n      padding: 5px 18px;\r\n      font-weight: bold;\r\n      cursor: pointer;\r\n      font-size: 13px;\r\n    }\r\n    .qty-ctrl {\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n      gap: 12px;\r\n      margin-top: 8px;\r\n    }\r\n    .qty-btn {\r\n      width: 28px; height: 28px;\r\n      background: #FFD700;\r\n      border: none;\r\n      border-radius: 50%;\r\n      font-size: 16px;\r\n      cursor: pointer;\r\n      font-weight: bold;\r\n    }\r\n    .qty-num { font-size: 16px; font-weight: bold; }\r\n\r\n    .cart-bar {\r\n      position: fixed;\r\n      bottom: 0; left: 0; right: 0;\r\n      background: #0F3460;\r\n      padding: 12px 16px;\r\n      display: none;\r\n    }\r\n    .cart-bar.visible { display: block; }\r\n    .note-input {\r\n      width: 100%;\r\n      background: transparent;\r\n      border: none;\r\n      border-bottom: 1px solid #444;\r\n      color: white;\r\n      padding: 6px 0;\r\n      font-size: 14px;\r\n      margin-bottom: 10px;\r\n      outline: none;\r\n    }\r\n    .note-input::placeholder { color: #555; }\r\n    .cart-row {\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: space-between;\r\n    }\r\n    .cart-info { font-size: 14px; }\r\n    .cart-info span { color: white; font-weight: bold; }\r\n    .send-btn {\r\n      background: #FFD700;\r\n      color: black;\r\n      border: none;\r\n      border-radius: 12px;\r\n      padding: 10px 20px;\r\n      font-weight: bold;\r\n      font-size: 14px;\r\n      cursor: pointer;\r\n    }\r\n    .send-btn:disabled { opacity: 0.6; }\r\n\r\n    .thanks {\r\n      display: none;\r\n      text-align: center;\r\n      padding: 80px 20px;\r\n    }\r\n    .thanks .big { font-size: 80px; }\r\n    .thanks h2 { font-size: 24px; margin: 16px 0 8px; }\r\n    .thanks p { color: #aaa; }\r\n    .new-order-btn {\r\n      margin-top: 30px;\r\n      background: #FFD700;\r\n      color: black;\r\n      border: none;\r\n      border-radius: 12px;\r\n      padding: 12px 30px;\r\n      font-size: 16px;\r\n      cursor: pointer;\r\n      font-weight: bold;\r\n    }\r\n  </style>\r\n</head>\r\n<body>\r\n\r\n<div id=\"menu-page\">\r\n  <div class=\"header\">\r\n    <h2>📋 المنيو</h2>\r\n    <p id=\"table-name\">{tableName}</p>\r\n  </div>\r\n\r\n  <div class=\"tabs\" id=\"tabs\"></div>\r\n  <div class=\"grid\" id=\"grid\"></div>\r\n\r\n  <div class=\"cart-bar\" id=\"cart-bar\">\r\n    <input class=\"note-input\" id=\"note\" placeholder=\"ملاحظة للطلب (اختياري)\">\r\n    <div class=\"cart-row\">\r\n      <div class=\"cart-info\">\r\n        <span id=\"cart-count\">0</span> صنف &nbsp;|&nbsp;\r\n        <span id=\"cart-price\">0</span> ج\r\n      </div>\r\n      <button class=\"send-btn\" id=\"send-btn\" onclick=\"sendOrder()\">\r\n        ➤ أرسل الطلب\r\n      </button>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<div class=\"thanks\" id=\"thanks-page\">\r\n  <div class=\"big\">✅</div>\r\n  <h2>تم إرسال طلبك!</h2>\r\n  <p>{tableName}</p>\r\n  <p style=\"margin-top:8px;color:#aaa\">سيتم تحضير طلبك قريباً 🎉</p>\r\n  <button class=\"new-order-btn\" onclick=\"newOrder()\">🔄 طلب جديد</button>\r\n</div>\r\n\r\n<script>\r\n  const TABLE_ID = {tableId};\r\n  const TABLE_NAME = '{tableName}';\r\n  \r\n  let allDrinks = [];\r\n  let cart = {};\r\n  let currentTab = null;\r\n\r\n  const categories = {categoriesJson};\r\n\r\n  const emojis = { hot:'☕', cold:'🧊', normal:'🥤', prodect:'🛍' };\r\n\r\n  async function loadMenu() {\r\n    try {\r\n      const res = await fetch('/api/menu');\r\n      allDrinks = await res.json();\r\n      buildTabs();\r\n      renderGrid(null);\r\n    } catch(e) {\r\n      document.getElementById('grid').innerHTML =\r\n        '<p style=\"text-align:center;color:#aaa;grid-column:span 2;padding:40px\">تعذر تحميل المنيو</p>';\r\n    }\r\n  }\r\n\r\n  function buildTabs() {\r\n    const tabs = document.getElementById('tabs');\r\n    categories.forEach((cat, i) => {\r\n      const tab = document.createElement('div');\r\n      tab.className = 'tab' + (i === 0 ? ' active' : '');\r\n      tab.textContent = cat.label;\r\n      tab.onclick = () => {\r\n        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));\r\n        tab.classList.add('active');\r\n        currentTab = cat.temp;\r\n        renderGrid(cat.temp);\r\n      };\r\n      tabs.appendChild(tab);\r\n    });\r\n  }\r\n\r\n  function renderGrid(temp) {\r\n    const filtered = temp ? allDrinks.filter(d => d.temperature === temp) : allDrinks;\r\n    const grid = document.getElementById('grid');\r\n    \r\n    if (filtered.length === 0) {\r\n      grid.innerHTML = '<p style=\"text-align:center;color:#aaa;grid-column:span 2;padding:40px\">لا يوجد منتجات</p>';\r\n      return;\r\n    }\r\n\r\n    grid.innerHTML = filtered.map(d => `\r\n      <div class=\"card ${(cart[d.id]||0)>0?'in-cart':''}\" id=\"card-${d.id}\">\r\n        <div class=\"emoji\">${emojis[d.temperature]||'🍹'}</div>\r\n        <div class=\"name\">${d.name}</div>\r\n        <div class=\"price\">${d.price} ج</div>\r\n        ${(cart[d.id]||0) === 0\r\n          ? `<button class=\"add-btn\" onclick=\"addToCart(${d.id})\">إضافة</button>`\r\n          : `<div class=\"qty-ctrl\">\r\n              <button class=\"qty-btn\" onclick=\"removeFromCart(${d.id})\">−</button>\r\n              <span class=\"qty-num\">${cart[d.id]}</span>\r\n              <button class=\"qty-btn\" onclick=\"addToCart(${d.id})\">+</button>\r\n            </div>`\r\n        }\r\n      </div>\r\n    `).join('');\r\n  }\r\n\r\n  function addToCart(id) {\r\n    cart[id] = (cart[id] || 0) + 1;\r\n    updateCartBar();\r\n    renderGrid(currentTab);\r\n  }\r\n\r\n  function removeFromCart(id) {\r\n    cart[id] = (cart[id] || 0) - 1;\r\n    if (cart[id] <= 0) delete cart[id];\r\n    updateCartBar();\r\n    renderGrid(currentTab);\r\n  }\r\n\r\n  function updateCartBar() {\r\n    const bar = document.getElementById('cart-bar');\r\n    const ids = Object.keys(cart);\r\n    if (ids.length === 0) { bar.classList.remove('visible'); return; }\r\n    bar.classList.add('visible');\r\n\r\n    let total = 0, count = 0;\r\n    ids.forEach(id => {\r\n      const drink = allDrinks.find(d => d.id == id);\r\n      if (drink) { total += drink.price * cart[id]; count += cart[id]; }\r\n    });\r\n    document.getElementById('cart-count').textContent = count;\r\n    document.getElementById('cart-price').textContent = total.toFixed(0);\r\n  }\r\n\r\n  async function sendOrder() {\r\n    const btn = document.getElementById('send-btn');\r\n    btn.disabled = true;\r\n    btn.textContent = 'جاري الإرسال...';\r\n\r\n    const items = Object.keys(cart).map(id => {\r\n      const drink = allDrinks.find(d => d.id == id);\r\n      return { drink_id: parseInt(id), drink_name: drink.name,\r\n               qty: cart[id], price: drink.price };\r\n    });\r\n\r\n    try {\r\n      await fetch('/api/order', {\r\n        method: 'POST',\r\n        headers: { 'Content-Type': 'application/json' },\r\n        body: JSON.stringify({\r\n          tableId: TABLE_ID,\r\n          tableName: TABLE_NAME,\r\n          note: document.getElementById('note').value,\r\n          items\r\n        })\r\n      });\r\n\r\n      document.getElementById('menu-page').style.display = 'none';\r\n      document.getElementById('thanks-page').style.display = 'block';\r\n    } catch(e) {\r\n      alert('فشل إرسال الطلب، حاول مرة تانية');\r\n      btn.disabled = false;\r\n      btn.textContent = '➤ أرسل الطلب';\r\n    }\r\n  }\r\n\r\n  function newOrder() {\r\n    cart = {};\r\n    document.getElementById('note').value = '';\r\n    document.getElementById('menu-page').style.display = 'block';\r\n    document.getElementById('thanks-page').style.display = 'none';\r\n    renderGrid(currentTab);\r\n  }\r\n\r\n  loadMenu();\r\n</script>\r\n</body>\r\n</html>\r\n": "\r\n<!DOCTYPE html>\r\n<html lang=\"ar\" dir