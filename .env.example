# Saytarly website — server config

# Port the website listens on
PORT=4600

# Private releases/devices repository (owner/repo)
RELEASES_REPO=COACHIKO/saytarly_releases

# Fine-grained PAT with Contents: Read+write on the repo above.
# Used ONLY server-side to read the devices folder and update licenses.
RELEASES_TOKEN=your_pat_here
