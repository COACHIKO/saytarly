# Saytarly website — server config

# Port the website listens on
PORT=4600

# Private releases/devices repository (owner/repo)
RELEASES_REPO=COACHIKO/saytarly_releases

# Fine-grained PAT with Contents: Read+write on the repo above.
# Used ONLY server-side to read the devices folder and update licenses.
RELEASES_TOKEN=your_pat_here

# Optional: override the built-in dashboard credentials.
# The built-in fallback is hardcoded in server.js and is never sent to the browser.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your_password_here

# Optional: set a stable random secret so admin sessions survive server restarts.
# SESSION_SECRET=replace_with_a_long_random_string

# Set to 1 only when running behind a trusted reverse proxy (HTTPS).
# TRUST_PROXY=1
