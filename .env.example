# ===========================
# Hatif App - Environment Configuration (template)
# ===========================
# Copy this file to .env and fill in real values. .env is NOT tracked
# (see .gitignore) - it contains secrets and machine-specific values.
#
# NOTE: .env is bundled into the app as an asset (pubspec.yaml assets),
# so it ships inside the MSIX/APK. Do NOT put build-only secrets here
# (keystore passwords etc.) - pass those via environment variables /
# CI secrets instead, or they will end up inside the distributed app.

# --- App Version ---
VERSION_NAME=2.0.8
BUILD_NUMBER=1
WINDOWS_VERSION_NAME=2.0.8.0

# --- GitHub Auto-Update Configuration ---
# Personal Access Token with read permissions for private GitHub repository
GITHUB_TOKEN=

# --- Keystore Configuration ---
# Build-time only. Prefer environment variables (CI secrets) over this file.
KEYSTORE_PASSWORD=CHANGE_ME
KEY_PASSWORD=CHANGE_ME
KEY_ALIAS=CHANGE_ME
KEYSTORE_FILE=hatif_keystore.jks

# --- Crash Reporting ---
# Runtime key for the crash-reporting backend, sent as the
# X-Crash-Report-Key header on POST /crash-reports. Unlike the build-only
# keystore values above, this one IS needed by the app at runtime, so it
# ships in the bundled .env. When empty, crash uploads are skipped and the
# app logs a single notice at startup.
CRASH_REPORT_KEY=
# Optional: override the crash-report endpoint (default shown).
CRASH_REPORT_URL=https://megamind.egytelecoms.com/crash-reports
